{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "bundler",
    "noImplicitAny": true,
    "sourceMap": true,
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "rootDir": "./src",
    "outDir": "./out"
  },
  "include": ["src/**/*"],
  "exclude": ["dev/server.ts"]
}
